{
  "name": "@quarterdeck/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Kristopher Prince",
  "exports": {
    ".": {
      "@quarterdeck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./intents": {
      "@quarterdeck/source": "./src/intents/index.ts",
      "types": "./dist/intents/index.d.ts",
      "default": "./dist/intents/index.js"
    },
    "./layouts": {
      "@quarterdeck/source": "./src/layouts/index.ts",
      "types": "./dist/layouts/index.d.ts",
      "default": "./dist/layouts/index.js"
    },
    "./stream-schema": {
      "@quarterdeck/source": "./src/stream/schema.ts",
      "types": "./dist/stream/schema.d.ts",
      "default": "./dist/stream/schema.js"
    },
    "./workspace-wording": {
      "@quarterdeck/source": "./src/workspace/wording.ts",
      "types": "./dist/workspace/wording.d.ts",
      "default": "./dist/workspace/wording.js"
    },
    "./ticket-spec": {
      "@quarterdeck/source": "./src/planner/spec.ts",
      "types": "./dist/planner/spec.d.ts",
      "default": "./dist/planner/spec.js"
    },
    "./replay-command": {
      "@quarterdeck/source": "./src/driver/replay-command.ts",
      "types": "./dist/driver/replay-command.d.ts",
      "default": "./dist/driver/replay-command.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/store/migrations', 'dist/store/migrations', { recursive: true })\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@quarterdeck/rules": "0.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  }
}
