{
  "name": "quarterdeck-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Kristopher Prince",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "rules",
    "packages/server",
    "packages/dashboard",
    "packages/cli",
    "site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prepare": "npm run build",
    "quarterdeck": "node scripts/quarterdeck.mjs",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/server/test && tsc --noEmit -p scripts/proof && tsc --noEmit -p packages/dashboard && tsc --noEmit -p packages/dashboard/test",
    "test": "npm run build && vitest run",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "prettier": "legion-toolkit/prettier",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "legion-toolkit": "^0.5.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
